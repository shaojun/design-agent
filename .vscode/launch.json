{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Design Agent: Slack",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/.venv/bin/design-agent",
            "args": ["slack"],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONUNBUFFERED": "1",
                "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
            },
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": false
        },
        {
            "name": "Design Agent: Feishu",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/.venv/bin/design-agent",
            "args": ["feishu"],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONUNBUFFERED": "1",
                "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
                "DESIGN_AGENT_WORKSPACE_ROOT": "workspace/feishu"
            },
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": false
        },
        {
            "name": "ARC: Web Client Explorer",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/scripts/agent-registration-center/app.py",
            "args": [
                "--port",
                "8099"
            ],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "justMyCode": true,
            "subProcess": false,
            "env": {
                "PYTHONUNBUFFERED": "1"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Uvicorn running on (http://\\S+)",
                "uriFormat": "%s"
            }
        }
    ]
}
