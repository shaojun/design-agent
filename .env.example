# Copy to .env (or use `design-agent config set KEY=value`); fill only the features you use.
# Blank optional values normally use the code default or disable that integration, as noted below.
# Names: DESIGN_AGENT_* configures this agent; vendor/channel keys retain their external names.
# Never put real credentials in this example. `config show` masks credential values.
# MDA: `mda deploy` forwards .env keys except LANGSMITH_* as deployment secrets. Use a separate
# minimal .env for MDA; omit self-hosted listeners, access tokens, channels and Nacos credentials.
# See docs/models.md, docs/self-hosting.md and docs/a2a-nacos.md for complete setup examples.

# === 01. Chat models and role selection ===
# The lead and helper roles share the configured provider unless a role explicitly selects another
# provider:model. Blank role models inherit the lead (learning uses a low-effort helper by default).
# MODEL_EFFORT is model-specific; blank lets the model registry choose. HELPER_EFFORT_CAP limits
# helper reasoning effort; MODEL_TIMEOUT_SECONDS bounds one model request, not an entire A2A task.
DESIGN_AGENT_MODEL=anthropic:claude-opus-5-5
DESIGN_AGENT_MODEL_EFFORT=high
DESIGN_AGENT_HELPER_MODEL=
DESIGN_AGENT_LOOK_MODEL=
DESIGN_AGENT_TOOL_SELECTOR_MODEL=
DESIGN_AGENT_LEARNING_MODEL=             # optional cheaper post-job review model
DESIGN_AGENT_HELPER_EFFORT_CAP=          # e.g. xhigh
DESIGN_AGENT_MODEL_TIMEOUT_SECONDS=600

# === 02. Model endpoints and provider credentials ===
# For a compatible endpoint, set MODEL_BASE_URL and MODEL_API_KEY_ENV to the NAME of its key
# variable, e.g. OPENROUTER_API_KEY. The key itself belongs in that variable. Direct providers use
# their native key below. Gateway model syntax is langsmith:provider/model. These are OUTBOUND
# provider credentials, unrelated to the INBOUND Agent access tokens in section 15.
DESIGN_AGENT_MODEL_BASE_URL=
DESIGN_AGENT_MODEL_API_KEY_ENV=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=                       # also used by Alibaba media; match endpoint region
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                         # also used for OpenAI images
GOOGLE_API_KEY=
LANGSMITH_API_KEY=                      # MDA, managed sandboxes, tracing, optional gateway
LANGSMITH_GATEWAY_API_KEY=

# === 03. Runtime, workspace and sandbox ===
# RUNTIME selects the deployment profile; SANDBOX selects where filesystem/tools execute.
# auto chooses an available sandbox; host runs on this machine and is intended for development.
# Docker uses SANDBOX_IMAGE; managed sandboxes use SNAPSHOT and resource/idle/egress settings.
# EGRESS_ALLOW is a comma-separated list of permitted hosts, not API credentials. WORKSPACE_ROOT
# holds runtime state/output; use separate directories for independently running instances.
DESIGN_AGENT_RUNTIME=local              # local | mda | self_hosted
DESIGN_AGENT_SANDBOX=auto               # auto | langsmith | docker | host
DESIGN_AGENT_SANDBOX_IMAGE=design-agent-sandbox:local
DESIGN_AGENT_SANDBOX_SNAPSHOT=
DESIGN_AGENT_SANDBOX_VCPUS=8
DESIGN_AGENT_SANDBOX_MEM_GIB=16
DESIGN_AGENT_SANDBOX_FS_GIB=16
DESIGN_AGENT_SANDBOX_IDLE_TTL_SECONDS=600
DESIGN_AGENT_SANDBOX_EGRESS_ALLOW=
DESIGN_AGENT_WORKSPACE_ROOT=workspace

# === 04. Concurrency, budget and prompt caching ===
# MAX_PARALLEL_BUILDERS limits concurrent builders. JOB_BUDGET_USD is a soft model-cost budget:
# the agent asks before exceeding it; it is not a hard cap on media or sandbox charges.
# Cache lifetimes apply to providers/models that support prompt caching (5m | 1h | off).
# MCP_MAX_TOOLS limits tools selected per call for models without native tool search.
DESIGN_AGENT_MAX_PARALLEL_BUILDERS=3
DESIGN_AGENT_JOB_BUDGET_USD=
DESIGN_AGENT_CACHE_TTL=1h
DESIGN_AGENT_HELPER_CACHE_TTL=5m
DESIGN_AGENT_MCP_MAX_TOOLS=8

# === 05. Brand, fonts and timezone ===
# BRAND_PATH contains the active brand pack; without a pack the bundled sample brand is used.
# PRIVATE_FONTS_DIR holds operator-supplied fonts. Keep private brand assets/fonts out of Git.
# TIMEZONE is an IANA zone used when a channel supplies no user timezone, e.g. Asia/Shanghai.
DESIGN_AGENT_BRAND_PATH=workspace/brand
DESIGN_AGENT_PRIVATE_FONTS_DIR=private-fonts
DESIGN_AGENT_TIMEZONE=UTC

# === 06. Media generation and transcription ===
# Media providers are selected independently from the chat model in section 01. Fill only keys
# for providers you use. IMAGE_MODEL selects the image model; TTS_MODEL/VOICE and SFX_MODEL below
# configure Alibaba routes when their provider is aliyun. ElevenLabs uses its own voice workflow.
# Alibaba base URLs must match the workspace/region of DASHSCOPE_API_KEY; API_HOST has no scheme.
# GROQ_API_KEY enables transcription; ELEVENLABS_API_KEY enables its voice/music/sound tools.
DESIGN_AGENT_IMAGE_PROVIDER=openai      # openai | aliyun
DESIGN_AGENT_IMAGE_MODEL=gpt-image-2.5-flare
DESIGN_AGENT_TTS_PROVIDER=elevenlabs    # elevenlabs | aliyun
DESIGN_AGENT_TTS_MODEL=qwen-audio-3.1-tts-flash
DESIGN_AGENT_TTS_VOICE=longanhuan_v3.1
DESIGN_AGENT_SFX_PROVIDER=elevenlabs    # elevenlabs | aliyun; local synth cues also available
DESIGN_AGENT_SFX_MODEL=qwen-audio-3.1-tts-next
ALIYUN_API_HOST=
ALIYUN_OPENAI_BASE_URL=                # https://<workspace-host>/compatible-mode/v1
ALIYUN_DASHSCOPE_BASE_URL=             # https://<workspace-host>/api/v1
ELEVENLABS_API_KEY=
GROQ_API_KEY=

# === 07. Paper canvas integration ===
# off disables Paper. local uses a local MCP endpoint or stdio; bridged uses a remote bridge.
# BRAND_FILE_ID is read-only; DRAFTS_FILE_ID is the working canvas. Write/delete/reorganize and
# generation permissions are opt-in. Paper generation bills the user's Paper plan. For MDA
# production, use the paper-bridge connection instead of embedding a bridge token in the sandbox.
PAPER_MODE=off                        # off | local | bridged
PAPER_MCP_URL=                        # e.g. http://127.0.0.1:29979/mcp
PAPER_BRIDGE_TOKEN=
PAPER_BRAND_FILE_ID=
PAPER_DRAFTS_FILE_ID=
PAPER_TEAM_ID=                        # optional bridge team check
PAPER_ALLOW_DELETES=0
PAPER_ALLOW_TOKEN_WRITES=0
PAPER_ALLOW_REORG=0
PAPER_ALLOW_GENERATION=0

# === 08. Other tool integrations ===
# Optional host-side tool credentials. MCP server definitions live in config/mcp.toml; putting
# a key here alone does not configure a server. Keys remain on the host, outside the sandbox.
EXA_API_KEY=

# === 09. Interaction, learning and observability ===
# These switches control presentation/harness features; channels may implement different views.
# ENABLE_TRACES enables the agent's trace-reading tools with host credentials, not caller-scoped
# access: disable it if callers must not read other threads' traces in this LangSmith project.
# TRACE_HOST enables trace links in footers. TEMPLATE_TELEMETRY adds template/version trace tags.
# TOOL_CLEARING enables Anthropic helper tool-result clearing. Learning reviews completed work.
DESIGN_AGENT_ENABLE_PROGRESS=1
DESIGN_AGENT_ENABLE_FOOTER=1
DESIGN_AGENT_ENABLE_STEERING=1
DESIGN_AGENT_TRACE_HOST=
DESIGN_AGENT_ENABLE_LEARNING=1
DESIGN_AGENT_ENABLE_TRACES=1
DESIGN_AGENT_TEMPLATE_TELEMETRY=1
DESIGN_AGENT_ENABLE_TOOL_CLEARING=0

# === 10. Managed Slack appearance and triggers ===
# Appearance for the MDA-managed Slack app; these do not configure a self-hosted Slack connection.
# Trigger settings decide whether all messages and bot-originated messages can invoke the agent.
DESIGN_AGENT_SLACK_NAME="Content Studio"
DESIGN_AGENT_SLACK_DESCRIPTION="On-brand design and motion from a chat thread."
DESIGN_AGENT_SLACK_BACKGROUND_COLOR=
DESIGN_AGENT_SLACK_TRIGGER_ON_ALL_MESSAGES=0
DESIGN_AGENT_SLACK_ALLOW_BOT_TRIGGERS=0

# === 11. Self-hosted Slack connection ===
# Optional independent channel. socket_mode uses BOT_TOKEN and APP_TOKEN; HTTP delivery requires
# signature verification with SIGNING_SECRET. These credentials do not authenticate A2A clients.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TRANSPORT=socket_mode

# === 12. Self-hosted Feishu connection ===
# Optional independent channel. Create a Feishu application and configure its app credentials.
# TENANT_KEY restricts which enterprise may trigger the bot; it is not an Agent access token.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=

# === 13. Self-hosted persistence and Docker Compose ===
# DATABASE_URL selects Postgres persistence; blank uses local SQLite state in WORKSPACE_ROOT.
# POSTGRES_PASSWORD and DOCKER_GID are Compose inputs, not Settings fields. Compose builds the
# database URL; DOCKER_GID must match the Docker socket group on the deployment host.
DATABASE_URL=
POSTGRES_PASSWORD=
DOCKER_GID=0

# === 14. Self-hosted HTTP listener ===
# `design-agent serve` hosts ordinary HTTP thread APIs and, when enabled, A2A on the SAME listener.
# HOST/PORT are bind settings, not the address advertised to callers. The A2A public origin is
# configured separately in section 16. Set these values before starting `design-agent serve`.
DESIGN_AGENT_API_HOST=127.0.0.1
DESIGN_AGENT_API_PORT=8080

# === 15. Inbound access tokens and caller identity (HTTP API and A2A) ===
# ACCESS_TOKEN_CALLERS is a mapping, NOT one token: <secret-token>:<caller-id>,<secret-token>:<caller-id>.
# It authenticates ordinary HTTP APIs AND A2A when A2A_ALLOW_ANONYMOUS=false. Clients send only
# the secret-token in `Authorization: Bearer ...`; they never send the caller-id in that header.
# Different callers have separate tasks/files; tokens mapped to the same caller share access.
# contextId separates conversations, not permissions. All anonymous A2A clients share one caller.
# Blank disables authenticated access; ordinary HTTP routes still require a valid configured token.
# Generate a mapping with `design-agent config generate DESIGN_AGENT_ACCESS_TOKEN_CALLERS`.
# These are inbound credentials, independent of model API keys and the Nacos account in section 17.
DESIGN_AGENT_ACCESS_TOKEN_CALLERS=       # token:caller pairs; keep this entire value secret

# === 16. A2A protocol, public address and AgentCard ===
# Blank A2A_URL disables A2A. Set it to this instance's reachable public OR LAN origin, without
# /a2a or another path, e.g. http://192.0.2.10:8765. It advertises endpoints; it does not bind a port.
# Anonymous defaults to true: no token needed; supplied tokens do not isolate anonymous callers.
# false requires a nonempty ACCESS_TOKEN_CALLERS mapping. Ordinary HTTP APIs remain authenticated.
# NAME identifies the logical agent. VERSION is the AgentCard release version, NOT the A2A protocol
# version (1.0); bump it when publishing a changed immutable Card to Nacos, not for every code edit.
# DOCUMENTATION_URL optionally links enabled instance channels and their separate access methods.
DESIGN_AGENT_A2A_URL=
DESIGN_AGENT_A2A_ALLOW_ANONYMOUS=true
DESIGN_AGENT_A2A_NAME=design-agent
DESIGN_AGENT_A2A_VERSION=1.0.0
DESIGN_AGENT_A2A_DOCUMENTATION_URL=

# === 17. Nacos registration and discovery (optional, independent from A2A) ===
# Blank NACOS_URL disables registration; A2A can still run. To register this instance, enable
# A2A above and use the Nacos HTTP origin without /nacos or /next, e.g. https://registry.example.com.
# The namespace is the Nacos namespace ID. Use an application account allowed to publish the Agent
# definition and register/heartbeat endpoints. These credentials log into Nacos; A2A callers cannot
# use them as Agent tokens. Nacos discovers endpoints and does not relay Agent conversation traffic.
DESIGN_AGENT_NACOS_URL=
DESIGN_AGENT_NACOS_NAMESPACE=public
DESIGN_AGENT_NACOS_USERNAME=
DESIGN_AGENT_NACOS_PASSWORD=

# === 18. Opt-in live tests ===
# Off by default. Live tests contact real providers and may incur charges; this switch is not
# required for normal Agent operation. LIVE_VOICE_ID selects an ElevenLabs voice for voice tests.
DESIGN_AGENT_LIVE_TESTS=0
DESIGN_AGENT_LIVE_VOICE_ID=
